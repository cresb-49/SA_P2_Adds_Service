              uuid="3f8b7a4e-2d7e-4c8d-9a0f-6a0f1b9d9b10">

    <!-- ====== Parameters ====== -->
    <parameter name="from" class="java.time.LocalDateTime"/>
    <parameter name="to" class="java.time.LocalDateTime"/>
    <parameter name="userFullName" class="java.lang.String"/>
    <parameter name="userId" class="java.util.UUID"/>

    <!-- ====== Fields (datos planos) ====== -->
    <field name="id" class="java.lang.String"/>
