            <element kind="textField" uuid="ddeeff00-1122-3344-5566-778899aabbcc" x="340" y="0" width="90" height="15" fontSize="8.0" textAdjust="ScaleFont" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
