        <element kind="textField" uuid="22334455-6677-8899-aabb-ccddeeff0011" x="0" y="50" width="515" height="15" fontSize="9.0" italic="true" hTextAlign="Center">
            <expression><![CDATA[
                "Compras del " + $P{from}.toLocalDate().toString() + " al " + $P{to}.toLocalDate().toString()
