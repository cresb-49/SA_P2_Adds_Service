                <expression><![CDATA[$F{type}]]></expression>
            </element>
            <element kind="textField" uuid="bbccddee-ff00-1122-3344-5566778899aa" x="90" y="0" width="170" height="15" fontSize="8.0" textAdjust="ScaleFont" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
