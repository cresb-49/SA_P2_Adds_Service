        <element kind="textField" uuid="7b9d4a74-1c47-4d02-8b5a-3a4c1a1d0b7f" x="0" y="65" width="515" height="15" fontSize="9.0" italic="true" hTextAlign="Center">
            <printWhenExpression><![CDATA[$P{userFullName} != null && !$P{userFullName}.isEmpty()]]></printWhenExpression>
            <expression><![CDATA["Usuario: " + $P{userFullName}]]></expression>
        </element>
    </title>

